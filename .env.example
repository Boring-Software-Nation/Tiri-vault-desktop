# Copy to .env (development) before `npm run dev` / `npm run build`.
# These are baked into the app at build time.

# Tiri relay (run it locally from the Tiri-relay repo)
VITE_API_HOST=http://localhost:3003
VITE_WS_URL=ws://localhost:3003

# Filecoin network: calibration (testnet, free test tokens) or mainnet
VITE_FILECOIN_NETWORK=calibration
# Optional JSON-RPC endpoint; defaults to https://api.calibration.node.glif.io/rpc/v1
# VITE_FILECOIN_RPC_URL=

# The build adds these hosts to the app's Content-Security-Policy automatically.
# Production builds: see BUILD.md.
